          "description": {
            "version": 1,
            "type": "doc",
            "content": [
              {
                "type": "codeBlock",
                "attrs": {},
                "content": [
                  {
                    "type": "text",
                    "text": "1. Task table remove accept and contentType, introduce new column called headers and keep accept and contentType as json.\n2. Create new table called connect.\n    id bigserial PRIMARY KEY,\n    created_at timestamp,\n    updated_at timestamp,\n    created_by bigint,\n    updated_by bigint,\n    is_deleted boolean DEFAULT false,\n    client_id bigserial NOT NULL,\n    task_type varchar(512) NOT NULL,\n    service_type varchar(512) NOT NULL,\n    auth_type varchar(512) NOT NULL,\n    header varchar(512), -- JSON String\n    user_email varchar(512) NOT NULL,\n    auth_token varchar(512) NOT NULL,\n    refresh_token varchar(512),\n\n3. Modify the task table \n    id bigserial PRIMARY KEY,\n    created_at timestamp,\n    updated_at timestamp,\n    created_by bigint,\n    updated_by bigint,\n    is_deleted boolean DEFAULT false,\n    client_id bigserial NOT NULL,\n    connect_id bigint,\n    url varchar(512) NOT NULL,    \n    execution_interval bigint DEFAULT 3600000,\n    last_sync_date timestamp without time zone\n\n4. AES Encryption and Decryption\n    Example:\n    Model Class:\n    @Column(name = Constants.INVOICE_NO)\n    @ColumnTransformer(\n            read=Constants.COLUMN_TRANSFORMER_READ_AES_INVOICE_NO,\n            write=Constants.COLUMN_TRANSFORMER_WRITE_AES_INVOICE_NO)\n    private String invoiceNo;\n\n    Constants: \n    String INVOICE_NO = \"invoice_no\";\n    String AES_KEY = \"1De@s21t1@3$5^\"; - get this from application.yaml\n    String COLUMN_TRANSFORMER_READ_AES_INVOICE_NO = \"AES_DECRYPT(\"+INVOICE_NO+\", '\"+AES_KEY+\"')\";\n    String COLUMN_TRANSFORMER_WRITE_AES_INVOICE_NO = \"AES_ENCRYPT(?, '\"+AES_KEY+\"')\";\n\n5. Based on client -  user email & mobile should not duplicated."
                  }
                ]
              }
            ]
          },
